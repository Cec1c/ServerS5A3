@@ -21,0 +23,48 @@ class OpenListPublicationTests(unittest.TestCase):
+    def test_ambiguous_upload_and_delayed_metadata_reconcile_without_second_put(self):
+        with tempfile.TemporaryDirectory() as d:
+            p=Path(d)/'blob';p.write_bytes(b'complete uploaded bytes');h=hashlib.sha256(p.read_bytes()).hexdigest();remote='/cloud/'+h+'.blob'
+            found=dict(code=200,data=dict(name=Path(remote).name,size=p.stat().st_size,is_dir=False,raw_url='https://cloudcube.wuxi.cn/blob'))
+            missing=dict(code=500,message='object not found',data=None)
+            for upload in (TimeoutError('response lost'),dict(code=503)):
+                with self.subTest(upload=type(upload).__name__):
+                    c=provider.OpenList('http://127.0.0.1:29449','synthetic-token')
+                    c.request=Mock(side_effect=[missing,upload,missing,found])
+                    stream=io.BytesIO(p.read_bytes());stream.status=200;opener=Mock();opener.open.return_value=stream
+                    with patch.object(provider,'build_opener',return_value=opener),patch.object(provider.time,'sleep'):
+                        self.assertEqual(c.ensure(p,h,remote),dict(path=remote,size=p.stat().st_size))
+                    self.assertEqual([x.args[:2] for x in c.request.call_args_list],[('POST','/api/fs/get'),('PUT','/api/fs/put'),('POST','/api/fs/get'),('POST','/api/fs/get')])
+
+    def test_missing_after_ambiguous_upload_stops_at_bounded_reads(self):
+        with tempfile.TemporaryDirectory() as d:
+            p=Path(d)/'blob';p.write_bytes(b'bytes');h=hashlib.sha256(p.read_bytes()).hexdigest()
+            missing=dict(code=404);c=provider.OpenList('http://127.0.0.1:29449','synthetic-token')
+            c.request=Mock(side_effect=[missing,TimeoutError(),missing,missing,missing])
+            with patch.object(provider.time,'sleep') as sleep,self.assertRaisesRegex(ValueError,'metadata failure'):
+                c.ensure(p,h,'/cloud/'+h+'.blob')
+            self.assertEqual(c.request.call_count,5);self.assertEqual(sleep.call_count,2)
+            self.assertEqual(sum(x.args[0]=='PUT' for x in c.request.call_args_list),1)
+
+    def test_transient_readback_restarts_digest_but_corruption_and_denial_stop(self):
+        with tempfile.TemporaryDirectory() as d:
