@@ -73,0 +91,11 @@ class OpenList:
+    def metadata(self,remote,wait_missing=False):
+        for attempt in range(3):
+            try:
+                obj=self.request('POST','/api/fs/get',dict(path=remote,password=''))
+                if not (wait_missing and missing_object(obj) and attempt<2):return obj
+            except ProviderHTTPError as error:
+                if not transient_status(error.status) or attempt==2:raise
+            except (OSError,http.client.HTTPException):
+                if attempt==2:raise
+            time.sleep(attempt+1)
