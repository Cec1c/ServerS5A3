+            with patch.object(provider,'build_opener',return_value=opener),patch.object(provider.time,'sleep') as sleep,self.assertRaisesRegex(ValueError,'SHA256 differs|exceeds expected size'):c.ensure(p,h,remote)
+            self.assertEqual(opener.open.call_count,1);sleep.assert_not_called()
