@@ -26,0 +29,14 @@ class NoRedirect(HTTPRedirectHandler):
+class ProviderHTTPError(ValueError):
+    def __init__(self,status):
+        self.status=status
+        super().__init__('OpenList HTTP status '+str(status))
+
+
+def transient_status(status):
+    return status in (408,429) or 500<=status<600
+
+
+def missing_object(obj):
+    return obj.get('code')==404 or (obj.get('code')==500 and obj.get('message')=='object not found' and obj.get('data') is None)
+
+
