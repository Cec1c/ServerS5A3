+            stream=io.BytesIO(p.read_bytes());stream.status=200;opener=Mock();opener.open.side_effect=[HTTPError('https://cloudcube.wuxi.cn/blob',503,'temporary',{},None),stream]
+            with patch.object(provider,'build_opener',return_value=opener),patch.object(provider.time,'sleep'):
+                c.ensure(p,h,remote)
