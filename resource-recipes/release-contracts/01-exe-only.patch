+"""Synthetic contract tests for EXE-only game resource transitions."""
+
+import copy
+import datetime
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[2]
+PRIVATE_PLANNER = ROOT / "private-content/20261101-client-only/client_publication_state.py"
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+WORKER = load_module("game_update_exe_only_worker", Path(__file__).with_name("game_update.py"))
+PLANNER = load_module("client_exe_only_planner", PRIVATE_PLANNER)
+
+
+def digest_json(value):
+    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def resource(path, sha256, length, blob_sha256, blob_length, **overrides):
+    value = {
+        "Path": path,
+        "Sha256": sha256,
+        "Length": length,
+        "BlobSha256": blob_sha256,
+        "BlobLength": blob_length,
+        "Compression": "gzip",
+        "Downloadable": True,
+    }
+    value.update(overrides)
+    return value
+
+
+class ExeOnlyTransitionContractTests(unittest.TestCase):
+    def setUp(self):
+        self.now = datetime.datetime(2026, 11, 1, 12, 0, tzinfo=datetime.timezone.utc)
+        self.old_exe = "a" * 64
+        self.new_exe = "e" * 64
+        self.pvf = "b" * 64
+        self.channel = "4" * 64
+        self.source_key = "local-guild:stable"
+        self.profile = {
+            "ApiUrl": "https://updates.example.invalid",
+            "ExeSha256": self.old_exe,
+            "PvfSha256": self.pvf,
+            "MinimumLauncherVersion": "1.0.5",
+            "AntiCheat": {"Enabled": True, "Policy": "reviewed"},
+            "RequireQQBinding": True,
+            "GameHost": "game.example.invalid",
+        }
+        old_files = [
+            resource("DNF.exe", self.old_exe, 1000, "1" * 64, 900, Origin="reviewed-client"),
+            resource("Script.pvf", self.pvf, 2000, "2" * 64, 1800, Origin="reviewed-pvf"),
+            resource(
+                "ImagePacks2/existing_app.NPK",
+                "c" * 64,
+                3000,
+                "3" * 64,
+                2500,
+                Compression="brotli",
+                Downloadable=False,
+                Policy={"owner": "existing-app"},
+            ),
+        ]
+        manifest_digest = digest_json({"files": old_files})
+        self.state = {
+            "authFingerprint": "synthetic-auth-metadata",
+            "sources": [{"id": "synthetic-source"}],
+            "sessions": {"session": {"expires": "future"}},
+            "sourceSequences": {self.source_key: 8, "other:stable": 31},
+            "sourceDigests": {self.source_key: manifest_digest, "other:stable": "d" * 64},
+            "published": {
+                "sequence": 20,
+                "product": "DNF90-Flutter",
+                "format": 1,
+                "profile": copy.deepcopy(self.profile),
+                "launcher": {"version": "1.0.5", "sha256": "c" * 64, "policy": "immutable"},
+                "news": [{"title": "keep"}],
+                "content": {
+                    "version": "client-old",
+                    "sourceId": "local-guild",
+                    "channel": "stable",
+                    "sourceSequence": 8,
+                    "sourcePayloadSha256": manifest_digest,
+                    "endpoint": "https://updates.example.invalid",
+                    "certificateSha256": "f" * 64,
+                    "files": copy.deepcopy(old_files),
+                },
+            },
+        }
+        self.replacement = {
+            "Sha256": self.new_exe,
+            "Length": 1100,
+            "BlobSha256": "9" * 64,
+            "BlobLength": 950,
+        }
+        self.plan_arguments = {
+            "state": self.state,
+            "profile": self.profile,
+            "replacement": self.replacement,
+            "version": "client-exe-only",
+            "expected_sequence": 20,
+            "expected_exe": self.old_exe,
+            "expected_pvf": self.pvf,
+        }
+        planned = PLANNER.plan(**self.plan_arguments)
+        self.before = copy.deepcopy(self.state["published"])
+        self.after = copy.deepcopy(planned["state"]["published"])
+        self.pair = {
+            "kind": "exe-only",
+            "basePvfSha256": self.pvf,
+            "baseExeSha256": self.old_exe,
+            "pvfSha256": self.pvf,
+            "exeSha256": self.new_exe,
+            "channelSha256": self.channel,
+        }
+        self.source = {
+            "sourceCommit": "1" * 40,
+            "serverSha256": "2" * 64,
+            "runtimeResourceUpdate": copy.deepcopy(self.pair),
+        }
+
+        indexes = {
+            "items.json": "6" * 64,
+            "pvf-directory.bin": "7" * 64,
+            "item-details-v3-" + self.pvf + ".bin": "8" * 64,
+            "quests-v1-" + self.pvf + ".bin": "9" * 64,
+            "professions-v1-" + self.pvf + ".bin": "a" * 64,
+            "expert-jobs-v1-" + self.pvf + ".json": "b" * 64,
+        }
+
+        def management(pid):
+            return {
+                "mode": "external-gm",
+                "pvfSha256": self.pvf,
+                "pid": pid,
+                "gatewaySha256": "5" * 64,
+                "indexes": copy.deepcopy(indexes),
+                "externalGM": {
+                    "pvfSha256": self.pvf,
+                    "indexes": copy.deepcopy(indexes),
+                    "programSha256": "3" * 64,
+                    "assetDirectory": "/assets/" + self.pvf,
+                    "at": "test",
+                    "catalogManifestHash": self.pvf,
+                },
+            }
+
+        self.old_management = management(123)
+        self.after_management = management(456)
+        self.old = {
+            "pvfSha256": self.pvf,
+            "exeSha256": self.old_exe,
+            "channelSha256": self.channel,
+            "publishedSha256": digest_json(self.before),
+            "management": copy.deepcopy(self.old_management),
+            "protectedPublished": copy.deepcopy(self.before),
+        }
+        self.current = {
+            "published": copy.deepcopy(self.after),
+            "management": copy.deepcopy(self.after_management),
+            "protectedPublished": copy.deepcopy(self.after),
+        }
+        self.transition = {
+            "format": 1,
+            "checkedAt": self.now.isoformat(),
+            "sourceCommit": self.source["sourceCommit"],
+            "serverSha256": self.source["serverSha256"],
+            "beforePublished": copy.deepcopy(self.before),
+            "afterPublished": copy.deepcopy(self.after),
+            "afterManagement": copy.deepcopy(self.after_management),
+            "channelSha256": self.channel,
+            "beforeProtected": copy.deepcopy(self.before),
+            "afterProtected": copy.deepcopy(self.after),
+        }
+
+    def raw_transition(self, value):
+        return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+
+    def call_pair(self, spec, old=None):
+        old = self.old if old is None else old
+        snapshot = copy.deepcopy((spec, old))
+        try:
+            return WORKER.checked_resource_pair(spec, old)
+        finally:
+            self.assertEqual((spec, old), snapshot)
+
+    def call_publication(self, before, after, pair=None):
+        pair = self.pair if pair is None else pair
+        snapshot = copy.deepcopy((before, after, pair))
+        try:
+            return WORKER.checked_pair_publication(before, after, pair)
+        finally:
+            self.assertEqual((before, after, pair), snapshot)
+
+    def refresh_after_digest(self, after):
+        after["content"]["sourcePayloadSha256"] = digest_json({"files": after["content"]["files"]})
+
+    def call_transition(self, value=None, current=None, source=None, old=None, raw=None,
+                        expected_sha=None, now=None):
+        value = copy.deepcopy(self.transition) if value is None else value
+        current = self.current if current is None else current
+        source = self.source if source is None else source
+        old = self.old if old is None else old
+        raw = self.raw_transition(value) if raw is None else raw
+        expected_sha = hashlib.sha256(raw).hexdigest() if expected_sha is None else expected_sha
+        now = self.now if now is None else now
+        snapshot = copy.deepcopy((value, current, source, old, raw, expected_sha, now))
+        try:
+            return WORKER.checked_pair_transition(raw, expected_sha, source, old, current, now)
+        finally:
+            self.assertEqual((value, current, source, old, raw, expected_sha, now), snapshot)
+
+    def test_real_pure_plan_is_exe_only_and_rejects_baseline_errors(self):
+        planned = PLANNER.plan(**self.plan_arguments)
+        self.assertEqual(planned["changed"], ["DNF.exe"])
+        self.assertEqual((planned["beforeSequence"], planned["sequence"]), (20, 21))
+        self.assertEqual(planned["state"]["published"]["profile"]["PvfSha256"], self.pvf)
+        self.assertEqual(planned["state"]["published"]["profile"]["ExeSha256"], self.new_exe)
+
+        for overrides in (
+            {"expected_exe": "0" * 64},
+            {"expected_pvf": "0" * 64},
+            {"expected_sequence": 19},
+        ):
+            arguments = copy.deepcopy(self.plan_arguments)
+            arguments.update(overrides)
+            with self.subTest(overrides=overrides), self.assertRaises(ValueError):
+                PLANNER.plan(**arguments)
+
+        for key in ("baseExeSha256", "basePvfSha256", "channelSha256"):
+            spec = copy.deepcopy(self.pair)
+            spec[key] = "0" * 64
+            with self.subTest(pair_baseline=key), self.assertRaisesRegex(
+                    ValueError, "paired resource baseline differs"):
+                self.call_pair(spec)
+
+    def test_exe_only_pair_requires_a_new_exe_and_an_identical_pvf(self):
+        self.assertIs(self.call_pair(self.pair), self.pair)
+        for key, value in (
+            ("exeSha256", self.old_exe),
+            ("pvfSha256", "f" * 64),
+        ):
+            spec = copy.deepcopy(self.pair)
+            spec[key] = value
+            with self.subTest(field=key), self.assertRaisesRegex(
+                    ValueError, "EXE-only update must preserve PVF and replace EXE"):
+                self.call_pair(spec)
+
+        with_bundle = copy.deepcopy(self.pair)
+        with_bundle["bundle"] = WORKER.BUNDLE008_ID
+        with self.assertRaises(ValueError):
+            self.call_pair(with_bundle)
+
+    def test_publication_accepts_only_exe_description_profile_and_sequences(self):
+        self.assertIsNone(self.call_publication(self.before, self.after))
+        self.assertEqual(self.before["sequence"] + 1, self.after["sequence"])
+        self.assertEqual(
+            self.before["content"]["sourceSequence"] + 1,
+            self.after["content"]["sourceSequence"],
+        )
+        self.assertEqual(self.after["content"]["files"][1:], self.before["content"]["files"][1:])
+        for field in ("launcher", "news", "product", "format"):
+            self.assertEqual(self.after[field], self.before[field])
+        expected_profile = copy.deepcopy(self.before["profile"])
+        expected_profile["ExeSha256"] = self.new_exe
+        self.assertEqual(self.after["profile"], expected_profile)
+        expected_exe = copy.deepcopy(self.before["content"]["files"][0])
+        expected_exe.update(self.replacement)
+        self.assertEqual(self.after["content"]["files"][0], expected_exe)
+
+    def test_publication_rejects_pvf_npk_launcher_policy_and_sequence_drift(self):
+        cases = (
+            (
+                "pvf",
+                lambda value: value["profile"].__setitem__("PvfSha256", "f" * 64),
+                False,
+                "paired profile identity differs",
+            ),
+            (
+                "other_file",
+                lambda value: value["content"]["files"][2].__setitem__("Sha256", "0" * 64),
+                True,
+                "changed unrelated APP, policy or content",
+            ),
+            (
+                "launcher",
+                lambda value: value["launcher"].__setitem__("version", "1.0.6"),
+                False,
+                "changed unrelated APP, policy or content",
+            ),
+            (
+                "policy",
+                lambda value: value["profile"]["AntiCheat"].__setitem__("Enabled", False),
+                False,
+                "changed unrelated APP, policy or content",
+            ),
+            (
+                "sequence",
+                lambda value: value.__setitem__("sequence", value["sequence"] + 1),
+                False,
+                "paired publication sequence differs",
+            ),
+        )
+        for name, mutate, refresh, message in cases:
+            after = copy.deepcopy(self.after)
+            mutate(after)
+            if refresh:
+                self.refresh_after_digest(after)
+            with self.subTest(case=name), self.assertRaisesRegex(ValueError, message):
+                self.call_publication(self.before, after)
+
+    def test_management_allows_only_the_top_level_gateway_pid_to_change(self):
+        self.assertIsNone(WORKER.checked_pair_management(
+            self.old_management, self.after_management, self.pair))
+
+        cases = (
+            ("gateway", lambda value: value.__setitem__("gatewaySha256", "0" * 64)),
+            ("gm", lambda value: value["externalGM"].__setitem__("programSha256", "0" * 64)),
+            ("index", lambda value: value["indexes"].__setitem__("items.json", "0" * 64)),
+            ("nested_index", lambda value: value["externalGM"]["indexes"].__setitem__(
+                "pvf-directory.bin", "0" * 64)),
+        )
+        for name, mutate in cases:
+            after = copy.deepcopy(self.after_management)
+            mutate(after)
+            with self.subTest(case=name), self.assertRaisesRegex(
+                    ValueError, "EXE-only update changed GM, indexes or configuration"):
