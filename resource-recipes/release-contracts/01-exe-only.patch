+            current = copy.deepcopy(self.current)
+            current["published"] = copy.deepcopy(value["afterPublished"])
+            current["management"] = copy.deepcopy(value["afterManagement"])
+            current["protectedPublished"] = copy.deepcopy(value["afterProtected"])
+            with self.subTest(case=name), self.assertRaises(ValueError):
+                self.call_transition(value=value, current=current)
+
+    def test_legacy_pair_contract_still_rejects_single_resource_changes(self):
+        exe_only = copy.deepcopy(self.pair)
+        exe_only.pop("kind")
+        pvf_only = copy.deepcopy(exe_only)
+        pvf_only["pvfSha256"] = "f" * 64
+        pvf_only["exeSha256"] = self.old_exe
+        for name, spec in (("exe_only", exe_only), ("pvf_only", pvf_only)):
+            with self.subTest(case=name), self.assertRaisesRegex(
+                    ValueError, "both paired resource identities must change"):
+                self.call_pair(spec)
+
+    def test_transition_evidence_accepts_the_300_second_boundary_only(self):
+        self.assertEqual(
+            self.call_transition(now=self.now + datetime.timedelta(seconds=300)),
+            self.transition,
+        )
+        with self.assertRaisesRegex(ValueError, "paired transition expired"):
+            self.call_transition(now=self.now + datetime.timedelta(seconds=301))
+
+        future = copy.deepcopy(self.transition)
+        future["checkedAt"] = (self.now + datetime.timedelta(seconds=1)).isoformat()
+        with self.assertRaisesRegex(ValueError, "paired transition expired"):
+            self.call_transition(value=future)
+
+
+if __name__ == "__main__":
+    unittest.main()
