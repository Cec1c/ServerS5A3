+def normalized_split_profile(before, after, pair):
+    """Only the verified publication profile may change resource hash fields."""
+    import copy
+    import re
+    normalized = copy.deepcopy(after)
+    if 'splitProfile' not in before and 'splitProfile' not in after:
+        if pair.get('kind') == 'exe-only' and ('splitConfigHashes' in before or 'splitConfigHashes' in after):
+            raise ValueError('EXE-only split profile evidence missing')
+        return normalized
+    prior, current = before.get('splitProfile'), after.get('splitProfile')
+    fields = {'path', 'sha256', 'value'}
+    if not isinstance(prior, dict) or not isinstance(current, dict) or set(prior) != fields or set(current) != fields:
+        raise ValueError('split profile evidence fields differ')
+    if not isinstance(prior['path'], str) or not prior['path'].startswith('/') or current['path'] != prior['path']:
+        raise ValueError('split profile path differs')
+    for state, proof in ((before, prior), (after, current)):
+        if (not isinstance(proof['value'], dict) or not isinstance(proof['sha256'], str) or
+                not re.fullmatch('[0-9a-f]{64}', proof['sha256']) or
+                state.get('splitConfigHashes', {}).get(proof['path']) != proof['sha256']):
+            raise ValueError('split profile fingerprint differs')
+    value = copy.deepcopy(current['value'])
+    for field, old_key, new_key in [('ExeSha256', 'baseExeSha256', 'exeSha256'),
+                                    ('PvfSha256', 'basePvfSha256', 'pvfSha256')]:
+        if prior['value'].get(field) != pair[old_key] or value.get(field) != pair[new_key]:
+            raise ValueError('split profile resource differs')
+        value[field] = prior['value'][field]
+    if value != prior['value']:
+        raise ValueError('split profile changed unrelated configuration')
+    normalized['splitProfile'] = copy.deepcopy(prior)
+    normalized['splitConfigHashes'][prior['path']] = prior['sha256']
+    return normalized
+
