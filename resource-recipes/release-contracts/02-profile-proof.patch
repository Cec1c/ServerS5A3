--- /dev/null
+++ b/deploy/remote/test_game_update_exe_profile.py
@@ -0,0 +1,64 @@
+"""Publication profile files change even while GM/index resources do not."""
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+
+spec = importlib.util.spec_from_file_location('exe_profile_fixture', Path(__file__).with_name('test_game_update_exe_only.py'))
+fixture = importlib.util.module_from_spec(spec); spec.loader.exec_module(fixture)
+worker = fixture.WORKER
+
+class SplitProfileTests(unittest.TestCase):
+    def setUp(self):
+        self.f = fixture.ExeOnlyTransitionContractTests(); self.f.setUp()
+        self.path = '/srv/hub-private/profile.json'
+        self.before = self.add_profile(self.f.old_management, self.f.profile)
+        self.after = self.add_profile(self.f.after_management, dict(self.f.profile, ExeSha256=self.f.new_exe))
+
+    def add_profile(self, management, profile):
+        value = copy.deepcopy(management)
+        digest = hashlib.sha256(json.dumps(profile, indent=2).encode()).hexdigest()
+        value['splitConfigHashes'] = {self.path: digest, '/srv/gateway.json': 'f'*64}
+        value['splitProfile'] = dict(path=self.path, sha256=digest, value=copy.deepcopy(profile))
+        return value
+
+    def test_exe_profile_and_gateway_pid_change_pass_full_transition(self):
+        f=self.f
+        f.old['management']=self.before
+        f.current['management']=self.after
+        f.transition['afterManagement']=self.after
+        self.assertEqual(f.call_transition(), f.transition)
+        self.assertNotEqual(self.before['splitProfile']['sha256'], self.after['splitProfile']['sha256'])
+
+    def test_other_profile_fields_cannot_change_even_with_matching_hash(self):
+        for field, value in [('RequireQQBinding', False), ('GameHost', 'other.invalid'), ('newSwitch', True), ('PvfSha256', 'f'*64)]:
+            profile=dict(self.after['splitProfile']['value'], **{field:value})
+            with self.subTest(field=field), self.assertRaises(ValueError):
+                worker.checked_pair_management(self.before, self.add_profile(self.f.after_management,profile), self.f.pair)
+
+    def test_other_config_hash_or_profile_path_changes_are_rejected(self):
+        after=copy.deepcopy(self.after);after['splitConfigHashes']['/srv/gateway.json']='0'*64
+        with self.assertRaises(ValueError):worker.checked_pair_management(self.before,after,self.f.pair)
+        after=copy.deepcopy(self.after);after['splitProfile']['path']='/srv/other.json'
+        with self.assertRaises(ValueError):worker.checked_pair_management(self.before,after,self.f.pair)
+
+    def test_missing_or_unbound_profile_evidence_is_rejected(self):
+        for where in ('proof','hash','both'):
+            before,after=copy.deepcopy(self.before),copy.deepcopy(self.after)
+            if where=='hash':after['splitConfigHashes'][self.path]='0'*64
+            elif where=='both':before.pop('splitProfile');after.pop('splitProfile')
+            else:after.pop('splitProfile')
+            with self.subTest(where=where), self.assertRaises(ValueError):
+                worker.checked_pair_management(before,after,self.f.pair)
+
+    def test_legacy_pvf_and_exe_profile_contract_keeps_exact_other_fields(self):
+        spec=importlib.util.spec_from_file_location('pair_profile_fixture',Path(__file__).with_name('test_game_update_resource_pair.py'))
+        module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+        f=module.ResourcePairContractTests();f.setUp()
+        before=self.add_profile(f.old['management'],f.before['profile'])
+        after=self.add_profile(f.after_management,f.after['profile'])
+        worker.checked_pair_management(before,after,f.pair)
+
+if __name__=='__main__':unittest.main()
