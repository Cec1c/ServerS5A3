+"""Paired-inbox contract for the closed equipment save scope field."""
+
+import copy
+import hashlib
+from pathlib import Path
+import tempfile
+import unittest
+
+import resource_bundle as bundles
+
+ABSENT = object()
+
+
+class EquipmentSaveScopeInbox(unittest.TestCase):
+    def spec(self, scope=ABSENT):
+        value = {
+            'kind': 'pvf-only',
+            'basePvfSha256': 'a' * 64,
+            'baseExeSha256': 'b' * 64,
+            'pvfSha256': 'c' * 64,
+            'exeSha256': 'b' * 64,
+            'channelSha256': 'd' * 64,
+        }
+        if scope is not ABSENT:
+            value['equipmentSaveScope'] = scope
+        return value
+
+    def manifest(self, spec):
+        files = {name: {'sha256': 'e' * 64, 'bytes': 1}
+                 for name in bundles.names(spec['pvfSha256'])}
+        files['Script.pvf']['sha256'] = spec['pvfSha256']
+        return {'schema': 1, 'spec': spec, 'files': files}
+
+    def test_scope_is_closed_and_optional(self):
+        for scope in ('collection', 'entry'):
+            with self.subTest(scope=scope):
+                spec = self.spec(scope)
+                self.assertEqual(bundles.manifest(self.manifest(spec))['spec'], spec)
+        spec = self.spec()
+        self.assertEqual(bundles.manifest(self.manifest(spec))['spec'], spec)
+
+    def test_invalid_or_environment_style_values_are_rejected(self):
+        for scope in ('', 'ENTRY', ' entry', 'on', 'off', True, 1, None, ['entry']):
+            with self.subTest(scope=scope), self.assertRaisesRegex(
+                    ValueError, 'equipment save scope must be collection or entry'):
+                bundles.manifest(self.manifest(self.spec(scope)))
+
+    def test_arbitrary_environment_name_is_not_a_bundle_field(self):
+        spec = self.spec('entry')
+        spec['DNFBRIDGE_EQUIPMENT_SAVE_SCOPE'] = 'entry'
+        value = self.manifest(spec)
+        with self.assertRaisesRegex(ValueError, 'invalid resource spec fields'):
+            bundles.manifest(value)
+
+    def test_validation_does_not_mutate_the_spec_or_manifest(self):
+        spec = self.spec('entry')
+        value = self.manifest(spec)
+        snapshot = copy.deepcopy(value)
+        self.assertEqual(bundles.manifest(value), snapshot)
+        self.assertEqual(value, snapshot)
+
+    def test_pack_and_unpack_preserve_the_exact_scope(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            inputs = root / 'inputs'
+            inputs.mkdir()
+            pvf = b'equipment-scope-pvf'
+            (inputs / 'Script.pvf').write_bytes(pvf)
+            for name in bundles.names(hashlib.sha256(pvf).hexdigest()) - {'Script.pvf'}:
+                (inputs / name).write_bytes(b'index')
+            spec = self.spec('entry')
+            spec['pvfSha256'] = hashlib.sha256(pvf).hexdigest()
+            archive = root / 'bundle.tar.gz'
+            pin = bundles.pack(spec, inputs, archive)
+            received = bundles.unpack(archive, pin['sha256'], root / 'received')
+            self.assertEqual(received['spec'], spec)
+            self.assertEqual(received['spec']['equipmentSaveScope'], 'entry')
+
+
+if __name__ == '__main__':
+    unittest.main()
