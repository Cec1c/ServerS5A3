@@ -0,0 +1,186 @@
+"""Closed equipment save scope binding through config, environment and rollback."""
+
+import ast
+import copy
+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+
+
+HERE = Path(__file__).resolve()
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+WORKER = load_module('equipment_scope_worker', HERE.with_name('game_update.py'))
+GENERATOR = HERE.parents[1] / 'docker' / 'manage.py'
+KEY = 'DNFBRIDGE_EQUIPMENT_SAVE_SCOPE'
+CLIENT = 'd1930d5bb07ee8fae348e0c23551b0f12bcfaea67ed7bf53ab0c9099e195c309'
+ABSENT = object()
+
+
+class EquipmentSaveScopeContract(unittest.TestCase):
+    def pair(self, scope=ABSENT):
+        value = dict(
+            kind='paired',
+            baseExeSha256='a' * 64,
+            basePvfSha256='b' * 64,
+            exeSha256=CLIENT,
+            pvfSha256='d' * 64,
+            channelSha256='c' * 64,
+            townDisplayOnly='on',
+            disjointEpicDisplay='paired-v1',
+            clientFiles={'DNF.exe': {'sha256': CLIENT, 'bytes': 112549888}},
+        )
+        if scope is not ABSENT:
+            value['equipmentSaveScope'] = scope
+        return value
+
+    def old(self):
+        return dict(exeSha256='a' * 64, pvfSha256='b' * 64, channelSha256='c' * 64)
+
+    def test_spec_field_is_closed_optional_and_compatible_with_existing_modes(self):
+        for scope in ('collection', 'entry'):
+            with self.subTest(scope=scope):
+                pair = self.pair(scope)
+                self.assertEqual(WORKER.paired_equipment_save_scope(pair), scope)
+                self.assertIs(WORKER.checked_resource_pair(pair, self.old()), pair)
+                self.assertEqual(WORKER.checked_town_display_target({}, pair, 'a' * 64), 'on')
+                self.assertEqual(WORKER.checked_disjoint_display_target({}, pair, 'a' * 64), 'paired-v1')
+        without = self.pair()
+        self.assertIsNone(WORKER.paired_equipment_save_scope(without))
+        self.assertIs(WORKER.checked_resource_pair(without, self.old()), without)
+
+    def test_invalid_values_and_arbitrary_environment_fields_are_rejected(self):
+        for scope in ('', 'ENTRY', ' entry', 'on', 'off', True, 1, None, ['entry']):
+            with self.subTest(scope=scope), self.assertRaisesRegex(
+                    ValueError, 'equipment save scope must be collection or entry'):
+                WORKER.paired_equipment_save_scope(self.pair(scope))
+        arbitrary = self.pair('entry')
+        arbitrary[KEY] = 'entry'
+        with self.assertRaisesRegex(ValueError, 'invalid paired resource fields'):
+            WORKER.checked_resource_pair(arbitrary, self.old())
+
+    def test_instance_environment_bytes_and_live_snapshot_agree(self):
+        before = {
+            'keep': 'unchanged',
+            'runtime_compatibility': {
+                'DNFBRIDGE_INVENTORY_SAVE_SCOPE': 'slot',
+                KEY: 'collection',
+            },
+        }
+        original = copy.deepcopy(before)
+        pair = self.pair('entry')
+        requested = WORKER.checked_equipment_save_scope_target(before, pair)
+        instance = WORKER.target_instance(before, 'new-image', None, equipment=requested)
+        self.assertEqual(before, original)
+        self.assertEqual(instance['runtime_compatibility'][KEY], 'entry')
+        self.assertEqual(instance['runtime_compatibility']['DNFBRIDGE_INVENTORY_SAVE_SCOPE'], 'slot')
+
+        raw = (b'KEEP=value\n'
+               b'DNFBRIDGE_INVENTORY_SAVE_SCOPE=slot\n'
+               b'DNFBRIDGE_EQUIPMENT_SAVE_SCOPE=collection\n'
+               b'DNFBRIDGE_CHANNEL_SCRIPT_ENCODING=gbk\n'
+               b'DNFBRIDGE_TOWN_DISPLAY_ONLY=on\n')
+        updated = WORKER.target_env_bytes(raw, None, encoding='gbk', town='on', equipment='entry')
+        self.assertEqual(updated.count((KEY + '=').encode()), 1)
+        self.assertIn((KEY + '=entry\n').encode(), updated)
+        self.assertEqual(WORKER.target_env_bytes(updated, None, equipment='collection'), raw)
+        rollback_paths = WORKER.rollback_config_paths([])
+        self.assertIn('runtime/docker/instance.json', rollback_paths)
+        self.assertIn('runtime/docker/server.env', rollback_paths)
+
+        env = WORKER.target_environment(
+            {'KEEP': 'value', 'DNFBRIDGE_INVENTORY_SAVE_SCOPE': 'slot',
+             'DNFBRIDGE_CHANNEL_SCRIPT_ENCODING': 'gbk', 'DNFBRIDGE_TOWN_DISPLAY_ONLY': 'on'},
+            None, encoding='gbk', town='on', equipment='entry')
+        self.assertEqual(WORKER.equipment_save_scope_snapshot(instance, env, env)['effectiveMode'], 'entry')
+        with self.assertRaisesRegex(AssertionError, 'equipment save scope environment differs'):
+            wrong = dict(env)
+            wrong[KEY] = 'collection'
+            WORKER.equipment_save_scope_snapshot(instance, env, wrong)
+
+    def test_missing_scope_preserves_existing_config_and_environment(self):
+        before = {
+            'runtime_compatibility': {
+                'DNFBRIDGE_INVENTORY_SAVE_SCOPE': 'slot',
+                KEY: 'entry',
+            },
+        }
+        raw = (b'DNFBRIDGE_INVENTORY_SAVE_SCOPE=slot\n'
+               b'DNFBRIDGE_EQUIPMENT_SAVE_SCOPE=entry\n')
+        self.assertIsNone(WORKER.checked_equipment_save_scope_target(before, self.pair()))
+        self.assertEqual(WORKER.target_instance(before, 'new-image', None), dict(before, server_image='new-image'))
+        self.assertEqual(WORKER.target_env_bytes(raw, None), raw)
+        self.assertEqual(WORKER.target_environment({'A': 'unchanged'}, None), {'A': 'unchanged'})
+        self.assertEqual(WORKER.equipment_save_scope_snapshot(before, {KEY: 'entry'}, {KEY: 'entry'})['effectiveMode'], 'entry')
+        self.assertEqual(WORKER.equipment_save_scope_snapshot({}, {}, {})['effectiveMode'], 'collection')
+
+    def test_invalid_instance_value_is_not_silently_replaced(self):
+        instance = {'runtime_compatibility': {KEY: 'slot'}}
+        with self.assertRaisesRegex(ValueError, 'equipment save scope must be collection or entry'):
+            WORKER.checked_equipment_save_scope_target(instance, self.pair('entry'))
+        with self.assertRaisesRegex(ValueError, 'equipment save scope must be collection or entry'):
+            WORKER.equipment_save_scope_snapshot(instance, {}, {})
+
+    def test_real_generator_matches_expected_bytes_and_keeps_existing_order(self):
+        manage = load_module('equipment_scope_generator', GENERATOR)
+        config = {
+            'host_ip': '192.168.1.50', 'server_ip': '10.254.90.2',
+            'database_ip': '10.254.90.3', 'subnet': '10.254.90.0/24',
+            'database_password': 'fixture', 'root_password': 'fixture',
+            'admin_token': 'ab' * 24, 'body_codec': 'plaintext',
+            'client_body_codec': 'plaintext', 'joust_event_enabled': True,
+            'runtime_compatibility': {'DNFBRIDGE_INVENTORY_SAVE_SCOPE': 'slot'},
+            'channel_script_encoding': 'gbk', 'gold_diagnostic_character': 42,
+            'disjoint_epic_display': 'paired-v1', 'town_display_only': 'off',
+        }
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            manage.RUNTIME = root / 'before'
+            manage.generate(config, {'ports': [10006]})
