+    def test_all_production_target_calls_thread_the_binding(self):
+        tree = ast.parse(HERE.with_name('game_update.py').read_text(encoding='utf-8'))
+        names = {'target_instance', 'target_environment', 'target_env_bytes'}
+        calls = [node for node in ast.walk(tree)
+                 if isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
+                 and node.func.id in names]
+        self.assertGreaterEqual(len(calls), 7)
+        for call in calls:
