+        changed = [node.value for node in ast.walk(tree)
+                   if isinstance(node, ast.Assign)
+                   and any(isinstance(target, ast.Name) and target.id == 'config_changed'
+                           for target in node.targets)]
+        self.assertEqual(len(changed), 1)
+        self.assertIn('config_equip', {node.id for node in ast.walk(changed[0])
