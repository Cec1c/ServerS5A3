FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS build
WORKDIR /src
COPY go-server/go.mod go-server/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY go-server/ ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -tags timetzdata -buildvcs=false -mod=readonly -trimpath -o /out/DNF90GM ./cmd/gmtool

FROM alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN addgroup -g 10001 dnf && adduser -D -u 10001 -G dnf dnf
COPY --from=build /out/DNF90GM /usr/local/bin/DNF90GM
WORKDIR /runtime
USER 10001:10001
ENTRYPOINT ["DNF90GM"]
