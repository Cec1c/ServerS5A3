# Docker protocol, gameplay, and compatibility reference, reviewed 2026-11-16.
# Do NOT hand-edit runtime/docker/server.env: merge deploy/templates/docker-instance.recommended.json
# into runtime/docker/instance.json and run `sh deploy/docker/manage.sh prepare` (or `DOCKER.bat prepare`).
# Replace <...> placeholders only when comparing against an external non-Docker runner.

# Matched official-24.9 client protocol (V212 - V215+).
DNFBRIDGE_CURRENT_CLIENT_VERSION=official-24.9
DNFBRIDGE_GAME_UPPER_HEADER=server16
DNFBRIDGE_GAME_UPPER_BODY_CODEC=plaintext
DNFBRIDGE_GAME_UPPER_CLIENT_BODY_CODEC=plaintext
DNFBRIDGE_DPROTO_MODE=legacy_patch
DNFBRIDGE_BUFF_GROUP_SYNC=on
DNFBRIDGE_BUFF_SWAP_REAPPLY=on

# Gameplay switches that default to off in raw Go source:
# - 青龙大会 / 黄龙大会 / 魂大会 MUST be set to exact literal `vendor` (`on`/`true`/`1` stay off!).
# - Keep horse racing (activity 2365) disabled until client crash fix is announced.
# - Native mileage shop (event 266) requires the matching PVF and client receive chain.
# - V210+ epic disjointer result popup (`paired-v1`) and V211+ lightweight town peer display (`on`).
DNFBRIDGE_DUNGEON_TOURNAMENT=vendor
DNFBRIDGE_JOUST_EVENT_ENABLED=false
DNFBRIDGE_MILEAGE_SHOP_ENABLED=off
DNFBRIDGE_DISJOINT_EPIC_DISPLAY=paired-v1
DNFBRIDGE_TOWN_DISPLAY_ONLY=on
DNFBRIDGE_CHANNEL_DIRECTORY_OWNER_RANGE=u8
DNFBRIDGE_PACKET_LOG=false

# Guild subsystems (all default to false/empty if omitted from instance.json).
DNFBRIDGE_GUILD_SOLO_CREATE=false
DNFBRIDGE_GUILD_RANKING_ENABLED=true
DNFBRIDGE_GUILD_ESSENCE_ENABLED=true
DNFBRIDGE_GUILD_HONGBAO_ENABLED=true
DNFBRIDGE_GUILD_CONTRIBUTION_POLICY=daily-v1
DNFBRIDGE_GUILD_GUARDIAN_POLICY={"first_purchase":"free_once","initial_level":1,"initial_skills":[1,1,1,1,1],"first_select":true}

# Production-verified runtime_compatibility switches (hell, party, login gates, delta writes & peak optimizations).
DNFBRIDGE_EXPERIMENTAL_PEAK=on
DNFBRIDGE_MYSQL_INSERT_BATCH=200
DNFBRIDGE_INVENTORY_SAVE_SCOPE=slot
DNFBRIDGE_EQUIPMENT_SAVE_SCOPE=entry
DNFBRIDGE_OWNER_CONTEXT_USE_CLIENT_CHANNEL=on
DNFBRIDGE_PARTY_SELECTOR_MEMBER_SELF_PREPARE=on
DNFBRIDGE_PARTY_DUNGEON_ALL_MEMBER_USER_STATE=all
DNFBRIDGE_DUNGEON_DEATH_ROOM_PROOF=room_proven
DNFBRIDGE_HELL_BLOCKED_SLOTS=on
DNFBRIDGE_DUNGEON_ENTRY_SELECTION_MODE=allow
DNFBRIDGE_PEER_USERINFO_IDENTITY_CARRIER_MODE0_GUARD=on
DNFBRIDGE_TOWN_NPC_EVENT_CATALOG=on
DNFBRIDGE_PARTY_FORMATION_ORDER=vendor_wire
DNFBRIDGE_PARTY_PEER_ENDPOINTS_AFTER_ROSTER=repeat
DNFBRIDGE_PARTY_PEER_ENDPOINT_REBROADCAST=on
DNFBRIDGE_LOGIN_AREA_GATES=strict
DNFBRIDGE_HOTKEY_SEEDED_LAYOUT=off
DNFBRIDGE_SKILL_SWITCH_CANDIDATE_PAIRS=off
DNFBRIDGE_LOGIN_SKILL_SWITCH_LOADOUT_AFTER_COMMIT=before_transition_only
DNFBRIDGE_PEER_SKILL_PAGE_TOWN=off
DNFBRIDGE_SKILL_SWITCH_DOWNLINK_SHAPE=off
DNFBRIDGE_SKILL_SWITCH_ANSWER_AT_SCENE_READY=off

# Relative paths inside the game container; select the 120-channel external ETC at prepare.
DNFBRIDGE_PVF_PATH=data/dnf/Script.pvf
DNFBRIDGE_CHANNEL_INFO_PATH=data/dnf/channel.override.etc
DNFBRIDGE_CHANNEL_INFO_BODY_MODE=latest
DNFBRIDGE_CHANNEL_SERVER_INDEX=1
DNFBRIDGE_CHANNEL_ADVERTISE_SERVER_INDEX=<CATALOG_ADVERTISE_SERVER_INDEX>
DNF_SCRIPT_VERSION=59
TZ=Asia/Shanghai

# Container bind addresses and the player-reachable advertised address differ.
DNFBRIDGE_CHANNEL_LISTEN=<GAME_CONTAINER_IP>:7001
DNFBRIDGE_GAME_LISTEN_HOST=<GAME_CONTAINER_IP>
DNFBRIDGE_SERVER_IP=<PLAYER_REACHABLE_GAME_IP>
DNFBRIDGE_ACCOUNT_API_LISTEN=<GAME_CONTAINER_IP>:17002
DNFBRIDGE_PARTY_UDP_RELAY_MODE=embedded
DNFBRIDGE_PARTY_UDP_RELAY_PORT_START=30000
DNFBRIDGE_PARTY_UDP_RELAY_PORT_COUNT=64

# Credentials are generated locally. LOGIN_TOKEN is a boolean, not a credential.
DNFBRIDGE_ACCOUNT_API_DSN=<GENERATED_DATABASE_DSN>
DNFBRIDGE_ACCOUNT_API_ALLOW_REGISTER=true
DNFBRIDGE_ACCOUNT_API_LOGIN_TOKEN=true
# Optional: generated only when game management access is configured.
# DNFBRIDGE_PLAYER_ADMIN_SECRET=<GENERATED_ADMIN_SECRET>
